<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Autorização de Compra <%= ordem.numero || '' %></title>
  <style>
    :root {
      --ink: #1f2937;
      --muted: #6b7280;
      --line: #d1d5db;
      --brand: #0b2545;
      --accent: #f59e0b;
      --paper: #fff;
      --bg: #f3f4f6;
    }
    @page { size: A4; margin: 12mm; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12px;
      line-height: 1.35;
    }
    .sheet {
      background: var(--paper);
      max-width: 210mm;
      margin: 0 auto;
      padding: 14mm 14mm 24mm;
      min-height: calc(297mm - 24mm);
      position: relative;
      display: flex;
      flex-direction: column;
    }
    .sheet-body {
      flex: 1;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding-bottom: 12px;
      border-bottom: 2px solid var(--brand);
      margin-bottom: 14px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand-mark {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--brand), #123b68);
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 800;
      font-size: 18px;
      letter-spacing: 1px;
    }
    .brand-name {
      font-size: 18px;
      font-weight: 800;
      letter-spacing: .06em;
      color: var(--brand);
    }
    .brand-sub {
      color: var(--muted);
      font-size: 11px;
      margin-top: 2px;
    }
    .title-block {
      text-align: right;
    }
    .doc-title {
      font-size: 24px;
      font-weight: 800;
      color: var(--brand);
      letter-spacing: .05em;
    }
    .doc-number {
      margin-top: 6px;
      font-size: 15px;
      font-weight: 700;
    }
    .doc-origin {
      margin-top: 4px;
      font-size: 10px;
      color: var(--muted);
      font-weight: 600;
      letter-spacing: .02em;
    }
    .section {
      border: 1px solid var(--line);
      border-radius: 10px;
      margin-bottom: 12px;
      overflow: hidden;
    }
    .section-title {
      background: #f9fafb;
      color: var(--brand);
      font-weight: 700;
      padding: 8px 10px;
      border-bottom: 1px solid var(--line);
      text-transform: uppercase;
      letter-spacing: .05em;
      font-size: 11px;
    }
    .section-body {
      padding: 10px;
    }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .grid-3 { display: grid; grid-template-columns: 1.1fr .9fr .9fr; gap: 10px; }
    .field {
      border-bottom: 1px dotted var(--line);
      min-height: 20px;
      padding: 0 4px 3px;
    }
    .label {
      font-size: 10px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .06em;
      margin-bottom: 2px;
    }
    .value { font-weight: 700; }
    .checks {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
    }
    .check {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }
    .box {
      width: 12px;
      height: 12px;
      border: 1px solid var(--ink);
      display: inline-block;
    }
    .box.filled { background: var(--brand); box-shadow: inset 0 0 0 2px #fff; }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      border: 1px solid var(--line);
      padding: 6px 5px;
      vertical-align: top;
    }
    th {
      background: #f9fafb;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .04em;
      color: var(--brand);
    }
    td { font-size: 11px; }
    .text-right { text-align: right; }
    .text-center { text-align: center; }
    .small { font-size: 10px; color: var(--muted); }
    .signature {
      margin-top: 16px;
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: end;
    }
    .signature-box {
      min-width: 240px;
      border-top: 1px solid var(--ink);
      padding-top: 6px;
      font-weight: 700;
    }
    .stamp {
      width: 290px;
      opacity: .95;
      display: block;
      margin: 10px 0 0 auto;
    }
    .stamp img {
      width: 100%;
      height: auto;
      display: block;
      image-rendering: auto;
    }
    .footer {
      margin-top: 12px;
      border-top: 1px solid var(--line);
      padding-top: 8px;
      color: var(--muted);
      font-size: 10px;
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }
    .approval-row {
      margin-top: 10px;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 8px;
      font-size: 10px;
      color: var(--muted);
    }
    .approval-row strong {
      font-weight: 700;
      color: var(--ink);
    }
    .muted { color: var(--muted); }
    @media print {
      body { background: #fff; }
      .sheet { padding: 0; min-height: auto; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body>
  <div class="sheet">
    <% const orderOrigins = [...new Set((ordem.itens || []).map((item) => String(item.fornecedor_origem || '').trim()).filter(Boolean))].join(', '); %>
    <div class="header">
      <div class="brand">
        <div class="brand-mark">C</div>
        <div>
          <div class="brand-name">CHEMARAUTO</div>
          <div class="brand-sub">Autorização de Compra</div>
        </div>
      </div>
      <div class="title-block">
        <div class="doc-title">AUTORIZAÇÃO DE COMPRA</div>
        <div class="doc-number">Nº <%= ordem.numero || '________' %></div>
        <% if (orderOrigins) { %>
          <div class="doc-origin">Origem: <%= orderOrigins %></div>
        <% } %>
      </div>
    </div>

    <div class="section">
      <div class="section-title">Fornecedor</div>
      <div class="section-body grid-2">
        <div>
          <div class="label">Fornecedor</div>
          <div class="field"><span class="value"><%= ordem.fornecedor_nome || '' %></span></div>
        </div>
        <div>
          <div class="label">Telefone</div>
          <div class="field"><span class="value"><%= ordem.fornecedor_telefone || '' %></span></div>
        </div>
        <div style="grid-column: 1 / -1;">
          <div class="label">Endereço</div>
          <div class="field"><span class="value"><%= ordem.fornecedor_endereco || '' %></span></div>
        </div>
        <% if (orderOrigins) { %>
          <div style="grid-column: 1 / -1;">
            <div class="label">Origem</div>
            <div class="field"><span class="value"><%= orderOrigins %></span></div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="section">
      <div class="section-title">Condições</div>
      <div class="section-body">
        <div class="grid-3">
          <div>
            <div class="label">Tipo</div>
            <div class="checks">
              <span class="check"><span class="box <%= ordem.tipo === 'contrato' ? 'filled' : '' %>"></span>Contrato</span>
              <span class="check"><span class="box <%= ordem.tipo === 'concorrencia' ? 'filled' : '' %>"></span>Concorrência</span>
              <span class="check"><span class="box <%= ordem.tipo === 'simples' ? 'filled' : '' %>"></span>Simples</span>
            </div>
          </div>
          <div>
            <div class="label">Prazo de entrega</div>
            <div class="field"><span class="value"><%= ordem.prazo_entrega ? new Date(ordem.prazo_entrega).toLocaleDateString('pt-BR') : '' %></span></div>
          </div>
          <div>
            <div class="label">Data de emissão</div>
            <div class="field"><span class="value"><%= ordem.data_emissao ? new Date(ordem.data_emissao).toLocaleDateString('pt-BR') : '' %></span></div>
          </div>
        </div>
        <div style="margin-top: 10px;">
          <div class="label">Condições de pagamento</div>
          <div class="field"><span class="value"><%= ordem.condicoes_pagamento || '' %></span></div>
        </div>
      </div>
    </div>

    <div class="sheet-body">
      <div class="section">
        <div class="section-title">Itens</div>
        <div class="section-body">
          <table>
            <thead>
              <tr>
                <th style="width: 6%;">Qtd</th>
                <th style="width: 8%;">Un</th>
                <th>Descrição</th>
                <th style="width: 12%;">Unitário</th>
                <th style="width: 12%;">Total</th>
                <th style="width: 14%;">Aplicação</th>
                <th style="width: 18%;">Origem</th>
              </tr>
            </thead>
            <tbody>
              <% if (ordem.itens && ordem.itens.length) { %>
                <% ordem.itens.forEach((item) => { %>
                  <tr>
                    <td class="text-center"><%= item.quantidade || '' %></td>
                    <td class="text-center"><%= item.unidade || '' %></td>
                    <td><%= item.descricao || '' %></td>
                    <td class="text-right"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(item.valor_unitario || 0) %></td>
                    <td class="text-right"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(item.valor_total || 0) %></td>
                    <td><%= item.aplicacao || ordem.veiculo_placa || '' %></td>
                    <td><%= item.fornecedor_origem || '-' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="7" class="text-center muted">Sem itens</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    <div class="section">
      <div class="section-title">Observações</div>
      <div class="section-body">
        <div class="field"><%= ordem.observacoes || '' %></div>
      </div>
    </div>

    <div class="section">
      <div class="section-title">Totais</div>
      <div class="section-body grid-2">
        <div><div class="label">Sub Total</div><div class="field"><span class="value"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(ordem.subtotal || 0) %></span></div></div>
        <div><div class="label">Total</div><div class="field"><span class="value"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(ordem.total || 0) %></span></div></div>
      </div>
    </div>

    <div class="signature">
      <div class="small">
        <div><strong>Pedido nº:</strong> <%= ordem.pedido_numero || '' %></div>
        <div><strong>Gerado por:</strong> <%= ordem.criado_por_nome || '' %></div>
      </div>
      <div class="signature-box">Controllers: ____________________________________</div>
    </div>

    <% if (ordem.aprovado_por_perfil === 'diretor') { %>
      <div class="stamp">
        <img src="/img/carimbo.png" alt="Carimbo de autorização do diretor">
      </div>
    <% } %>

    <div class="footer">
      <div>
        Matriz: Rua ... | Filial: Rua ... | Tel: ... | contato@chemarauto.com.br
      </div>
      <div>
        <strong>Chemarauto</strong>
      </div>
    </div>
  </div>

  <script>
    window.addEventListener('load', () => {
      setTimeout(() => window.print(), 300);
    });
  </script>
</body>
</html>
